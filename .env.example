# Turso / libSQL Database Configuration
# For production or remote Turso database:
TURSO_DATABASE_URL="libsql://your-database-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# For local development with SQLite (optional fallback):
# TURSO_DATABASE_URL="file:./dev.db"
# TURSO_AUTH_TOKEN=""

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Administrative API Key Guard (Phase 7 temporary protection)
# Note: Full auth provider (OAuth/Auth.js) is deferred to a future phase.
# Protects internal admin mutation API endpoints (/api/admin/...) from public access.
MASSAF_ADMIN_API_KEY="your-admin-api-key-here"

# PayLio Payment Integration Credentials (Server-side Only)
# NEVER expose PAYLIO_API_KEY or PAYLIO_WEBHOOK_SECRET to client side or via NEXT_PUBLIC_*
PAYLIO_API_KEY="your-paylio-api-key-here"
PAYLIO_API_URL="https://api.paylio.io/v1"
PAYLIO_WEBHOOK_SECRET="your-paylio-webhook-secret-here"
MASSAF_POLYGON_WALLET_ADDRESS="0x0000000000000000000000000000000000000000"
