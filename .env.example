# Turso / libSQL Database Configuration
# For production or remote Turso database:
TURSO_DATABASE_URL="libsql://your-database-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# For local development with SQLite (optional fallback):
# TURSO_DATABASE_URL="file:./dev.db"
# TURSO_AUTH_TOKEN=""

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Administrative API Key Guard
# Protects internal admin mutation API endpoints (/api/admin/...) and server actions from unauthorized access.
MASSAF_ADMIN_API_KEY="your-admin-api-key-here"

# Cloudflare R2 Media Storage Credentials (Server-side Only)
# NEVER expose R2_ACCESS_KEY_ID or R2_SECRET_ACCESS_KEY via NEXT_PUBLIC_* or to the browser
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="massaf"
R2_PUBLIC_URL="https://pub-your-r2-hash.r2.dev"

# Scheduled Jobs / Cron Security Guard
# Protects scheduled processing route (/api/cron/scheduled-jobs) against unauthorized triggers.
CRON_SECRET="your-cron-secret-here"

# PayLio Payment Integration Credentials (Server-side Only)
# NEVER expose PAYLIO_API_KEY or provider secrets to client side or via NEXT_PUBLIC_*
PAYLIO_API_KEY="your-paylio-api-key-here"
PAYLIO_API_URL="https://paylio.org/api/v1"
# Public settlement wallet address where PayLio settles USDC on Polygon
MASSAF_POLYGON_WALLET_ADDRESS="0x0000000000000000000000000000000000000000"
# Set to "true" for local development or automated testing (strictly disabled in NODE_ENV=production)
# PAYLIO_MOCK_MODE="true"

# Telegram Notification Integration (Server-side Only)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_ADMIN_CHAT_ID="your-telegram-admin-chat-id"
# Set to "true" for local development or automated testing
# TELEGRAM_MOCK_MODE="true"

# Email Dispatcher Credentials (Server-side Only)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="MASSAF Platform <noreply@massaf.com>"
# Set to "true" for local development or automated testing
# RESEND_MOCK_MODE="true"
